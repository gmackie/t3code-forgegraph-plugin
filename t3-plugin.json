{
  "schemaVersion": 2,
  "id": "com.t3code.forgegraph",
  "displayName": "ForgeGraph",
  "version": "0.2.0",
  "mcpServer": {
    "name": "forgegraph",
    "transport": {
      "type": "http",
      "url": "https://forgegraf.com/api/mcp",
      "headers": [],
      "auth": {
        "type": "oauth",
        "scopes": [
          "forgegraph:read"
        ]
      }
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "overview",
        "title": "Delivery overview",
        "scope": "project",
        "resourceUri": "ui://forgegraph/overview"
      },
      {
        "id": "changes",
        "title": "Changes",
        "scope": "project",
        "resourceUri": "ui://forgegraph/changes"
      },
      {
        "id": "checks",
        "title": "Checks",
        "scope": "project",
        "resourceUri": "ui://forgegraph/checks"
      }
    ],
    "commands": [
      {
        "id": "open-overview",
        "title": "ForgeGraph: Open delivery overview",
        "panel": "overview"
      },
      {
        "id": "open-changes",
        "title": "ForgeGraph: Open changes",
        "panel": "changes"
      },
      {
        "id": "open-checks",
        "title": "ForgeGraph: Open checks",
        "panel": "checks"
      }
    ]
  },
  "t3Tools": []
}
